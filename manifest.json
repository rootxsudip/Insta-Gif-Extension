{
  "manifest_version": 3,
  "name": "Instagram GIF Collector by 0xSudip",
  "version": "1.0",
  "description": "View GIFS from Instagram",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>",
        "https://api.giphy.com/*"
    ],
      "js": ["content.js"]
    }
  ]
}